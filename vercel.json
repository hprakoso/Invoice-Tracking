{
  "buildCommand": "prisma generate && next build",
  "functions": {
    "src/app/api/**": {
      "maxDuration": 30
    },
    "src/app/api/invoices/[id]/ocr/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 1 * * *"
    }
  ]
}
