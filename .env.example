# Required
DATABASE_URL="postgresql://invoice_user:invoice_pass@localhost:5433/invoice_demo"
NEXTAUTH_SECRET="any-random-string-at-least-32-chars"
# REQUIRED in every deployed environment, not just locally: it is the base URL
# of the "Lihat Invoice" button in every notification email. When unset the code
# falls back to http://localhost:3000 silently — no error, no log — so real
# vendors receive emails whose links point at localhost. Must differ per env.
NEXTAUTH_URL="http://localhost:3000"

# Required on any host that is NOT Vercel (Cloud Run, a VM, docker). NextAuth
# derives trustHost from AUTH_URL/AUTH_TRUST_HOST/VERCEL/CF_PAGES — NEXTAUTH_URL
# is deliberately not in that list — so with NODE_ENV=production and none of
# them set, every auth request fails with UntrustedHost: a total login outage on
# first boot. Vercel sets VERCEL=1 itself, which is why this is invisible there.
AUTH_TRUST_HOST=

# Optional — TLS to a hosted Postgres. prisma.ts strips sslmode/sslaccept from
# DATABASE_URL and only configures TLS through this flag. The single supported
# value is "false", which connects over TLS *without verifying the certificate*
# — needed for Supabase's pooler cert chain. Leave empty for local Postgres.
DATABASE_SSL_REJECT_UNAUTHORIZED=
CRON_SECRET="any-random-string"  # required to call GET /api/cron/reminders. Set this value in Vercel's env vars too — Vercel automatically sends it as the Authorization header on its own cron-triggered requests once it's set, no extra wiring needed.

# Only needed when running `prisma migrate deploy`/`migrate dev` against a hosted
# Postgres (e.g. Supabase) — direct connection, not the pooler. Falls back to
# DATABASE_URL if unset (fine for local dev). App runtime never uses this.
#
# ⚠️ prisma.config.ts resolves `DIRECT_URL ?? DATABASE_URL`, so DIRECT_URL WINS
# for every Prisma CLI command. Setting it in a local .env.local while
# DATABASE_URL points at docker means `prisma migrate`/`db:seed` target the
# hosted database while the app targets local — and prisma/seed.ts wipes every
# table before it writes. Keep this set only in the deploy environment, or
# override both variables explicitly per command. See docs/UAT_AND_CUTOVER.md.
DIRECT_URL=

# Optional — file storage. Create a Supabase project + a private "invoices"
# bucket. Without these, uploads fall back to local disk (uploads/invoices/),
# which doesn't persist on Vercel.
#
# ⚠️ This pair is read at module load and is INDEPENDENT of DATABASE_URL, so a
# dev machine with these set writes real objects into that bucket while its
# invoice rows go to the local database. Point them at a separate UAT project,
# or leave both blank to keep uploads on local disk. If either is missing on a
# serverless/container host the upload still "succeeds" onto an ephemeral disk
# and only fails later, from another instance, with ENOENT.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — OCR (vision) + chat (query_invoices tool). Get a free-tier key at
# https://aistudio.google.com/. Without it, OCR returns a clear error and the
# chatbot replies with a friendly "not available" message.
GOOGLE_API_KEY=
GEMINI_MODEL="gemini-2.5-flash"

# Optional — reminder/notification emails. Without it, in-app notifications
# still work; only the email side no-ops. resend.dev's default sender only
# delivers to your own account email until you verify a domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Invoice Tracking <onboarding@resend.dev>"
